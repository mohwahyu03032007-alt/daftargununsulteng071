<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- HEADER ATAS (WARNA HIJAU SAGE / SOFT NATURE GREEN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3E6B50"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Gunung Top di Sulawesi Tengah"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Informasi Gunung Populer dan Ketinggiannya"
            android:textColor="#E8F5E9"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- WIDGET PENAMPUNG UTAMA (BACKGROUND + CONTENT) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F2F5">

        <!-- GAMBAR BACKGROUND PEMANDANGAN -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.90"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_gunung" />

        <!-- KONTEN DAFTAR & SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- KOLOM PENCARIAN (TAMPILAN SAJA, NON-AKTIF) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:drawableEnd="@android:drawable/ic_menu_search"
                    android:focusable="false"
                    android:hint="Cari Gunung (Nama/Ketinggian)..."
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <!-- LISTVIEW DENGAN PEMBATAS TRANSPARAN UNTUK MEMISAHKAN KARTU -->
            <ListView
                android:id="@+id/listViewGunung"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="12dp"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>